---
import { siteConfig } from '@/data/site.config'
interface Props {
	size?: number
	class?: string
}
const { size = 48, class: className } = Astro.props
---

<img
	src={siteConfig.logo}
	width={size}
	height={size}
	alt='Fitness Journey'
	loading='lazy'
	class:list={['shrink-0 rounded-xl bg-white ring-1 ring-black/10', className]}
	style={`width:${size}px;height:${size}px`}
/>
