---
// placement: end — 記事末の大型カード。frontmatter の cta で訴求を切り替える
import StoreBadges from '@/components/cta/StoreBadges'
import AppLogo from '@/components/cta/AppLogo'
import { CTA_COPY, type CtaVariant } from '@/data/cta'

interface Props {
	variant?: CtaVariant
}
const { variant = 'default' } = Astro.props
const copy = CTA_COPY[variant] ?? CTA_COPY.default
---

<section
	class='not-prose my-10 overflow-hidden rounded-2xl bg-accent text-white shadow-lg'
	aria-label='Fitness Journey アプリの紹介'
	data-cta-variant={variant}
>
	<div class='flex flex-col gap-5 p-6 md:flex-row md:items-center md:gap-8 md:p-8'>
		<AppLogo size={72} class='rounded-2xl' />
		<div class='flex min-w-0 flex-1 flex-col gap-2'>
			<p class='text-xs font-bold tracking-wider opacity-90'>ジム習慣アプリ Fitness Journey</p>
			<p class='text-2xl font-extrabold leading-snug md:text-3xl'>{copy.heading}</p>
			<p class='text-base font-medium leading-relaxed'>{copy.body}</p>
			<StoreBadges placement='end' class='mt-3' />
		</div>
	</div>
</section>
