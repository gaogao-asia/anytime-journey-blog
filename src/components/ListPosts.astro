---
import type { CollectionEntry } from 'astro:content'
import PostCard from '@/components/PostCard'
import CtaList from '@/components/cta/CtaList'
import { cn } from '@/utils'

type Props = {
	posts: CollectionEntry<'blog'>[]
	FirstBig?: boolean
}

const { posts, FirstBig = false } = Astro.props

// アプリ導線カードを 1 行目の直後(記事が少なければ末尾)に挟む
const ctaIndex = Math.min(FirstBig ? 2 : 3, posts.length)
---

<section
	class={cn(
		`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3  gap-8 mt-3`,
		FirstBig && `md:[&>*:first-child]:col-span-2`
	)}
>
	{
		posts.map(async (post, index) => {
			const { remarkPluginFrontmatter } = await post.render()

			return (
				<>
					{index === ctaIndex && <CtaList />}
					<PostCard
						id={post.id}
						data={post.data}
						slug={post.slug}
						readTime={remarkPluginFrontmatter.minutesRead}
					/>
				</>
			)
		})
	}
	{posts.length > 0 && ctaIndex === posts.length && <CtaList />}
</section>
