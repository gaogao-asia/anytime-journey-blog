---
// placement: dialogue — キャラクターがアプリを紹介する吹き出し
// 例: <TalkCta who="misaki" text="通った日はアプリでチェックインしておくと、続いているのが見えて楽しいわよ" />
import Talk from '@/components/mdx/Talk'
import AppLink from '@/components/cta/AppLink'
import AppLogo from '@/components/cta/AppLogo'
import type { TalkWho } from '@/data/characters'

interface Props {
	who?: TalkWho
	text?: string
	label?: string
}
const {
	who = 'misaki',
	text = '私は Fitness Journey でジムに行った日を記録してるの。週間目標があると、自然と続くのよ',
	label = 'Fitness Journey を無料で使う'
} = Astro.props
---

<Talk who={who}>
	<p>{text}</p>
	<AppLink
		placement='dialogue'
		class='mt-3 flex items-center gap-3 rounded-xl bg-white p-2.5 pr-4 text-stone-950 shadow-sm ring-1 ring-accent/40 transition-shadow hover:shadow-md'
	>
		<AppLogo size={40} class='rounded-lg' />
		<span class='min-w-0 flex-1 text-sm font-bold leading-snug text-accent'>{label} →</span>
	</AppLink>
</Talk>
