---
// 対話形式記事の吹き出し
// 例: <Talk who="kenta">プロテインっていつ飲むのがいいんですか？</Talk>
import { TALK_CHARACTERS, type TalkWho } from '@/data/characters'

interface Props {
	who?: TalkWho
	name?: string
}
const { who = 'kenta', name } = Astro.props
const character = TALK_CHARACTERS[who] ?? TALK_CHARACTERS.kenta
const right = character.side === 'right'
---

<div
	class:list={['talk not-prose my-5 flex items-start gap-3', right && 'flex-row-reverse']}
	data-who={who}
>
	<div class='flex w-12 shrink-0 flex-col items-center gap-1'>
		<span
			class:list={[
				'flex h-12 w-12 items-center justify-center rounded-full text-lg font-bold text-white',
				character.avatarClass
			]}
			aria-hidden='true'
		>
			{character.initial}
		</span>
		<span class='text-xs font-bold text-gray-600 dark:text-gray-300'>{name ?? character.name}</span>
	</div>
	<div
		class:list={[
			'talk-bubble min-w-0 max-w-[85%] rounded-2xl px-4 py-3 text-base leading-relaxed md:text-lg',
			right ? 'rounded-tr-sm' : 'rounded-tl-sm',
			character.bubbleClass
		]}
	>
		<slot />
	</div>
</div>
